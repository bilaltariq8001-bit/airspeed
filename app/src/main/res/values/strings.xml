    <!-- About Screen -->
    <string name="about_title">About Velocity</string>
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_tagline">Precision offline-first GPS speedometer and automotive telemetry.</string>
    <string name="about_privacy_title">Privacy &amp; Data</string>
    <string name="about_privacy_body">Velocity processes all GPS speed, altitude, compass heading, and trip history strictly on your device. No telemetry, analytics, or location data is uploaded to any server. Network access is used solely when loading online map tiles on the Trip Detail screen or downloading fonts.</string>
    <string name="about_maps_notice_title">Maps Notice</string>
    <string name="about_maps_notice_body">Trip route maps use Google Maps SDK for Android when configured with an API key, or OpenStreetMap via osmdroid offline-capable tiles as a fallback.</string>
